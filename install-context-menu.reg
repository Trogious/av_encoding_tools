Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\SystemFileAssociations\.avi\shell\GetDuration]
@="Get Duration"
"Icon"="C:\\Windows\\System32\\shell32.dll,165"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.avi\shell\GetDuration\command]
@="\"C:\\Path\\To\\dur.exe\" \"%1\" --gui"

